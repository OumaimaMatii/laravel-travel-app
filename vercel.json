{
    "version": 2,
    "builds": [
        {
            "src": "public/index.php",
            "use": "vercel-php@8.2"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "public/index.php"
        },
        {
            "src": "/(.*)",
            "dest": "public/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "LOG_CHANNEL": "stderr"
    }
}